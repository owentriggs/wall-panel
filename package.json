{
  "name": "wall-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight touch UI for Home Assistant (custom panel)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@preact/signals": "^1.3.0",
    "home-assistant-js-websocket": "^9.4.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^22.20.5",
    "gzip-size": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
